{
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.82.1",
    "@earendil-works/pi-ai": "^0.82.0",
    "@earendil-works/pi-coding-agent": "^0.82.0",
    "@earendil-works/pi-tui": "^0.82.0",
    "acorn": "^8.17.0",
    "firecrawl": "^4.30.0",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "format": "prettier --write \"extensions/ask-user/**/*.{ts,cjs}\" \"*.json\" && oxfmt --write extensions/subagent",
    "format:check": "prettier --check \"extensions/ask-user/**/*.{ts,cjs}\" \"*.json\" && oxfmt --check extensions/subagent",
    "lint": "oxlint extensions/subagent --ignore-pattern test",
    "test": "bun test extensions/subagent"
  }
}
