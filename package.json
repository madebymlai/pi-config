{
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "check:load": "bun scripts/load-check.ts",
    "format": "prettier --write \"*.json\"",
    "format:check": "prettier --check \"*.json\"",
    "lint": "oxlint extensions --ignore-pattern \"**/test/**\" --ignore-pattern \"**/tests/**\"",
    "test": "node --test extensions/powerline-footer/test/*.test.ts extensions/bash-guard/test/*.test.ts && npm --prefix extensions/interactive-subagents test",
    "test:all": "npm test && npm --prefix extensions/interactive-subagents run test:integration",
    "verify": "npm run check && npm run lint && npm run test:all && npm run check:load"
  }
}
