{
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.3",
    "@earendil-works/pi-tui": "^0.84.3",
    "typebox": "^1.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "oxlint": "^1.73.0",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "check:load": "bun scripts/load-check.ts",
    "format": "prettier --write \"*.json\"",
    "format:check": "prettier --check \"*.json\"",
    "lint": "oxlint extensions --ignore-pattern \"**/test/**\" --ignore-pattern \"**/tests/**\"",
    "test": "npm --prefix extensions/interactive-subagents test",
    "test:all": "npm --prefix extensions/interactive-subagents run test:all",
    "verify": "npm run check && npm run lint && npm run test:all && npm run check:load"
  }
}
